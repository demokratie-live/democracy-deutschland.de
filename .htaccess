# Generated at build time by src/lib/htaccess.ts from content/site/routes.yaml,
# content/site/app-links.yaml and content/blog/. Do not edit the exported file.
# Apache 2.4 (Plesk). Hosts without .htaccess use the client-side redirects.

ErrorDocument 404 /404.html
# Live sends text/html; charset=UTF-8.
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Only the production host may be indexed.
  <If "%{HTTP_HOST} !~ /^(www\.)?democracy-deutschland\.de$/">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  # The app reads the donation status on every start: always revalidate.
  <Files "donation_status.json">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

RewriteEngine On

# App (democracy-client): /api.php?call=donation_status serves the static JSON
# as application/json, whether PHP is enabled or not.
RewriteRule ^api\.php$ api/donation_status.json [L]

# Encoded hash in old app links (democracy-client#1142): /%23!<state> → /#!<state>
RewriteRule ^(.*)#(.*)$ /$1#$2 [R=301,L,NE]

# Old page parameter on / and /index.php: ?page=<state>, ?_escaped_fragment_=<state>.
# Other parameters stay: ?page=unsubscribe&token=X → /unsubscribe/?token=X.
RewriteCond %{QUERY_STRING} ^(?:page|_escaped_fragment_)=([^&]*)(?:&(.*))?$
RewriteRule ^(?:index\.php)?$ - [E=LEGACY:1,E=LEGACY_STATE:%1,E=LEGACY_QUERY:%2]
RewriteCond %{ENV:LEGACY} !=1
RewriteCond %{QUERY_STRING} ^(.+?)&(?:page|_escaped_fragment_)=([^&]*)(&.*)?$
RewriteRule ^(?:index\.php)?$ - [E=LEGACY:1,E=LEGACY_STATE:%2,E=LEGACY_QUERY:%1%3]

RewriteCond %{ENV:LEGACY_STATE} =home
RewriteRule ^ /?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =wahlometer
RewriteRule ^ /wahlometer/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =about
RewriteRule ^ /ueber-uns/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =press
RewriteRule ^ /presse/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =donate
RewriteRule ^ /spenden/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =contact
RewriteRule ^ /kontakt/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =faq
RewriteRule ^ /faq/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =blog
RewriteRule ^ /blogseite/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =engineering
RewriteRule ^ /engineering/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =citizen
RewriteRule ^ /buerger/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =politicians
RewriteRule ^ /politiker/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =impressum
RewriteRule ^ /impressum/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =datenschutz
RewriteRule ^ /datenschutz/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =nutzungsbedingungen
RewriteRule ^ /nutzungsbedingungen/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

RewriteCond %{ENV:LEGACY_STATE} =unsubscribe
RewriteRule ^ /unsubscribe/?%{ENV:LEGACY_QUERY} [R=301,L,NE]

# Unknown states land on the start page like live.
RewriteCond %{ENV:LEGACY} =1
RewriteRule ^ /?%{ENV:LEGACY_QUERY} [R=301,L,NE]

# Aliases (routes.yaml)
RewriteRule ^democracy/?$ / [R=301,L]

# WordPress short links /blog/?p=<id>, ?cat=<id>, ?author=<id> → permalinks (301 like WordPress)
