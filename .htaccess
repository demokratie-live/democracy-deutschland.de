# Unknown post IDs: 404 like WordPress
RewriteCond %{QUERY_STRING} (?:^|&)p=[0-9]+(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ - [R=404]
RewriteCond %{QUERY_STRING} (?:^|&)cat=1(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/category/allgemein/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)cat=2(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/category/newsletter/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)cat=90(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/category/kommentar/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)cat=107(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/category/erklaerung/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)cat=108(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/category/reality-check/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)author=3(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/author/marius/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)author=5(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/author/timo/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)author=6(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/author/jasper/? [R=301,L]
# ?tag=<slug>, ?m=<yyyymm>, ?m=<yyyy> and ?feed=… like WordPress
RewriteCond %{QUERY_STRING} (?:^|&)tag=([a-z0-9-]+)(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/tag/%1/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)m=([0-9]{4})([0-9]{2})(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/%1/%2/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)m=([0-9]{4})(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/%1/? [R=301,L]
RewriteCond %{QUERY_STRING} (?:^|&)feed=(?:rss2?|atom|rdf)(?:&|$)
RewriteRule ^blog/(?:index\.php)?$ /blog/feed/? [R=301,L]

# Old entry point /index.php (index.php?page=<state> goes with the states)
RewriteRule ^index\.php$ / [R=301,L]

# Tester sign-up of the old site (old .htaccess: invite, invite/<code> → invite.php?code=).
# It is gone, links from /engineering/, blog posts and mails land on the start page.
RewriteRule ^invite(?:\.php|/[^/]*/?)?$ /? [R=301,L]

# Spellings of the Wahl-O-Meter (/Wahlometer, /wahl-o-meter, …)
RewriteCond %{REQUEST_URI} !=/wahlometer/
RewriteRule ^wahl-?o-?meter/?$ /wahlometer/ [R=301,L,NC]

# Old APK download → GitHub release (302: “latest” moves with every release)
RewriteRule ^files/download/democracy-app\.apk$ https://github.com/demokratie-live/democracy-client/releases/latest/download/democracy-app.apk [R=302,L]

# Old AAB download → GitHub release
RewriteRule ^files/download/democracy-app\.aab$ https://github.com/demokratie-live/democracy-client/releases/latest/download/democracy-app.aab [R=302,L]

# WordPress entry point /blog/index.php (its queries ?p=, ?cat= … are handled above)
RewriteRule ^blog/index\.php$ /blog/ [R=301,L]

# Page 1 of a list is the list itself: /blog/page/1/, /blog/category/<slug>/page/1/
RewriteRule ^blog/(.+/)?page/1/?$ /blog/$1 [R=301,L]

# Only RSS 2.0 exists statically; Atom and RDF feeds forward to it
RewriteRule ^blog/((?:.+/)?)feed/(?:atom|rdf|rss2?)/?$ /blog/$1feed/ [R=301,L]

# Feeds: the export writes …/feed/index.html; serve it as RSS like WordPress.
RewriteRule ^blog/(?:.+/)?feed/index\.html$ - [T=application/rss+xml;charset=UTF-8]
