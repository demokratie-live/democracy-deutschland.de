{
  "name": "democracy-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-content": "tsx scripts/validate-content.ts",
    "compare": "tsx scripts/compare.ts",
    "prepare": "git config --local core.hooksPath .husky",
    "test:basepath": "NEXT_PUBLIC_BASE_PATH=/democracy-deutschland.de NEXT_PUBLIC_CONTACT_ENDPOINT=/contact-endpoint next build && playwright test --config playwright.basepath.config.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.2.3",
    "next-mdx-remote": "^6.0.0",
    "popper.js": "1.12.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-raw": "^7.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "diff": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.2",
    "serve": "^14.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
